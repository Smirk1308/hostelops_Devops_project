FLASK_APP=hostelops:create_app
SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=sqlite:///hostelops.db
OVERDUE_HOURS=48
MODEL_PATH=ml/model.joblib
APP_VERSION=0.1.0

# Demo seeding: set to 1 only when intentionally running the demo seed script.
HOSTELOPS_ENABLE_DEMO_SEED=0

# Set strong local values before enabling demo seeding. Never commit real values.
HOSTELOPS_SEED_ADMIN_PASSWORD=
HOSTELOPS_SEED_STAFF_PASSWORD=
HOSTELOPS_SEED_STUDENT_PASSWORD=

# Set to 1 only to explicitly rotate existing demo account passwords.
HOSTELOPS_ROTATE_DEMO_PASSWORDS=0
